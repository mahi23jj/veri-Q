[TEMPLATE]
# Copy to .env in this directory and fill in real values. Never commit .env.

# VeriQ backend as seen from inside the container. host.docker.internal points
# at the developer's machine; use the backend's compose service name instead if
# you put the VeriQ backend on the same compose network.
VERIQ_API_URL=http://host.docker.internal:8000
# Issued once when the application is registered with VeriQ:
#   POST /api/v1/applications  ->  {"api_key": "vq_..."}
VERIQ_API_KEY=CHANGE_ME

# Queues. Keep them distinct: the VeriQ runner only submits to the VeriQ queue.
CELERY_NORMAL_QUEUE=normal
VERIQ_QUEUE=veriq.test

# Dedicated test database for the target application. Never production data.
TARGET_POSTGRES_DB=targetapp
TARGET_POSTGRES_USER=targetapp
TARGET_POSTGRES_PASSWORD=CHANGE_ME
