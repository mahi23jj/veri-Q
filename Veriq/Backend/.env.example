# Copy to .env and fill in real values. Never commit .env.
# PostgreSQL (used by docker-compose)
POSTGRES_DB=queueproof
POSTGRES_USER=queueproof
POSTGRES_PASSWORD=CHANGE_ME

# Backend
APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# Ports
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Frontend
# Leave empty to use the Vite dev proxy (/api -> backend:8000 in compose,
# http://localhost:8000 outside compose).
VITE_API_URL=
